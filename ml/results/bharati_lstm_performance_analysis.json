    "primary_causes": [
      {
        "factor": "Inter-Sensor Baseline Error Disparity",
        "description": "Clean normal reconstruction error varies dramatically across sensors (median 0.0041 for PRESS_001 vs 0.0284 for VIB_001). A single global threshold (0.0132) is below VIB_001 nominal baseline, causing 98.89% FPR on VIB_001 under V1."
      },
      {
        "factor": "Trailing Window Reconstruction Lag",
        "description": "The 30-observation rolling sequence maintains high reconstruction MSE for 29 time steps after an anomaly event resolves, producing point-in-time false alarms on trailing normal points (FPR ~75% on trailing normal)."
      },
      {
        "factor": "Flatline Reconstruction Limitation",
        "description": "LSTM autoencoder captures temporal dynamic shapes well (100% Spike recall, 83.3% Drift recall) but assigns low reconstruction error to zero-variance flatlines, necessitating downstream heuristic classification."
      }
    ]
  },
