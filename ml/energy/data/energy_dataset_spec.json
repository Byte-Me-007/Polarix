  "forecasting_targets": {
    "target_power_demand_1h_kw": {
      "target_type": "regression",
      "unit": "kW",
      "horizon": "1-hour ahead (t -> t+1h)",
      "primary_use_case": "Short-term spinning reserve & peak load dispatch",
      "recommended_initial_target": true
    },
    "target_battery_soc_1h_percent": {
      "target_type": "regression",
      "unit": "%",
      "horizon": "1-hour ahead (t -> t+1h)",
      "primary_use_case": "Battery health protection & deep-discharge prevention",
      "recommended_initial_target": true
    },
    "target_energy_demand_6h_kwh": {
      "target_type": "regression",
      "unit": "kWh",
      "horizon": "6-hour ahead (t -> t+6h)",
      "primary_use_case": "Generator bank switching & intermediate energy staging",
      "recommended_initial_target": false
    },
    "target_energy_demand_24h_kwh": {
      "target_type": "regression",
      "unit": "kWh",
      "horizon": "24-hour ahead (t -> t+24h)",
      "primary_use_case": "Day-ahead fuel burn optimization & blizzards scheduling",
      "recommended_initial_target": false
    },
    "target_energy_deficit_risk": {
      "target_type": "classification",
      "classes": ["NORMAL", "DEFICIT_RISK"],
      "horizon": "1 to 24-hour lookahead",
      "primary_use_case": "Early warning alert trigger when demand exceeds available generation + BESS buffer",
      "recommended_initial_target": false
    }
  },
  "temporal_split_strategy": {
    "method": "Strict Chronological Partition (No shuffling)",
    "train_ratio": 0.70,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "leakage_prevention_rules": [
      "Normalization scalers (MinMaxScaler / StandardScaler) fit strictly on train partition only.",
      "Lagged rolling features (e.g. 1h/6h rolling mean, EWMA) computed causally using timestamps <= t only.",
      "Candidate model selection and hyperparameter tuning performed on validation partition only.",
      "Held-out test partition evaluated once after freezing models and thresholds."
    ]
  }
}
